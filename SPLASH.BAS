10 REM AURORA.BAS - BOREALIS splash screen
20 SCREEN 13
30 GCLS 0
40 REM starfield
50 FOR I=1 TO 120
60 PSET RND*320,RND*90,15
70 NEXT I
80 REM aurora curtain, colors 32..71
90 FOR X=0 TO 319
100 Y=50+35*SIN(X/25)
110 FOR K=0 TO 40
120 PSET X,Y+K+15*SIN((X+K)/17),32+INT(39*K/40)
130 NEXT K
140 NEXT X
150 REM animate by cycling the palette
160 T=0
170 T=T+1
180 FOR C=0 TO 39
190 G=31+31*SIN((C+T)/9)
200 B=20+20*SIN((C+T)/5)
210 PALETTE 32+C,0,G,B
215 DELAY 10
220 NEXT C
230 DELAY 1000
250 SCREEN 0
259 CLEAR
